# ============================================================================
# CAREERWAVE — VERCEL + SUPABASE ENVIRONMENT CONFIGURATION
# ============================================================================
# Required in Vercel Project Settings -> Environment Variables:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional alias supported for backward compatibility:
VITE_SUPABASE_ANON_KEY=

# ============================================================================
# SUPABASE EDGE FUNCTION SECRETS (Set ONLY in Supabase Dashboard / CLI, NEVER in Vercel)
# Run: supabase secrets set APIFY_TOKEN=... GEMINI_API_KEY=... OPENROUTER_API_KEY=... ELEVENLABS_API_KEY=...
# ============================================================================
# APIFY_TOKEN=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=
# JSEARCH_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=

# Gemini API Key (server-side AI generation, resume parsing, job scoring, and spoken voice interview agent)
GEMINI_API_KEY=

# OpenRouter Fallback API Key (optional server-side fallback for resume parsing/rewriting)
OPENROUTER_API_KEY=

# Multi-Source Live Job Aggregator Secrets (Server-side / Supabase Edge Function secrets ONLY — never expose on client)
# 1. Primary Source: JSearch API on RapidAPI (Google for Jobs: LinkedIn, Indeed, Glassdoor, Naukri, Apna, Company Career Pages)
JSEARCH_API_KEY=

# 2. Secondary Optional Source: Adzuna Job Search API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 3. Secondary Optional Source: Jooble Job Aggregator API
JOOBLE_API_KEY=

# Optional ElevenLabs API Key (server-side voice synthesis fallback)
ELEVENLABS_API_KEY=

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

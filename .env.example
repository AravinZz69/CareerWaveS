# ============================================================================
# CAREERWAVE — PORTABLE ENVIRONMENT CONFIGURATION (HOSTINGER / AWS / NODE VPS)
# ============================================================================
PORT=3000
NODE_ENV=production

# Portable Database Configuration (Unified Schema in src/types.ts & supabase/schema.sql)
# Supported values for DATABASE_DIALECT: mysql (Hostinger) | postgres (AWS RDS / Supabase) | sqlite (Lightweight VPS)
DATABASE_DIALECT=mysql
DATABASE_URL=

# Optional Hostinger MySQL / MariaDB Connection Variables
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=careerwave_prod
MYSQL_USER=
MYSQL_PASSWORD=

# Optional AWS RDS / Aurora PostgreSQL / Supabase Connection Variables
POSTGRES_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API Key (server-side AI generation, resume parsing, job scoring, and spoken voice interview agent)
GEMINI_API_KEY=

# OpenRouter Fallback API Key (optional server-side fallback for resume parsing/rewriting)
OPENROUTER_API_KEY=

# Multi-Source Live Job Aggregator Secrets (Server-side ONLY — never expose on client)
# 1. Primary Source: JSearch API on RapidAPI (Google for Jobs: LinkedIn, Indeed, Glassdoor, Naukri, Apna, Company Career Pages)
JSEARCH_API_KEY=

# 2. Secondary Optional Source: Adzuna Job Search API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 3. Secondary Optional Source: Jooble Job Aggregator API
JOOBLE_API_KEY=

# Optional ElevenLabs API Key (server-side voice synthesis fallback)
ELEVENLABS_API_KEY=
